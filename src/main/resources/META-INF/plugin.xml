<idea-plugin>
  <id>com.noctis.intellij</id>
  <name>Noctis</name>
  <version>0.2.0</version>
  <idea-version since-build="233"/>
  <depends>com.intellij.modules.platform</depends>
  <vendor url="https://github.com/liviuschera/noctis">Noctis JetBrains port</vendor>
  <description><![CDATA[
    Noctis theme collection port for IntelliJ Platform IDEs.
  ]]></description>
  <change-notes><![CDATA[
    <ul>
      <li>Fidelity pass against upstream VS Code Noctis: buttons, selections, status bar, menus, links, badges, checkboxes, scroll bars, banners.</li>
      <li>Fix editor scheme effect types, default text background, selection color, and align syntax mapping with upstream TextMate rules.</li>
    </ul>
  ]]></change-notes>
  <extensions defaultExtensionNs="com.intellij">
    <themeProvider id="com.noctis.intellij.lux" path="/themes/noctis-lux.theme.json"/>
    <themeProvider id="com.noctis.intellij.hibernus" path="/themes/noctis-hibernus.theme.json"/>
    <themeProvider id="com.noctis.intellij.lilac" path="/themes/noctis-lilac.theme.json"/>
    <themeProvider id="com.noctis.intellij.noctis" path="/themes/noctis.theme.json"/>
    <themeProvider id="com.noctis.intellij.azureus" path="/themes/noctis-azureus.theme.json"/>
    <themeProvider id="com.noctis.intellij.bordo" path="/themes/noctis-bordo.theme.json"/>
    <themeProvider id="com.noctis.intellij.obscuro" path="/themes/noctis-obscuro.theme.json"/>
    <themeProvider id="com.noctis.intellij.sereno" path="/themes/noctis-sereno.theme.json"/>
    <themeProvider id="com.noctis.intellij.uva" path="/themes/noctis-uva.theme.json"/>
    <themeProvider id="com.noctis.intellij.viola" path="/themes/noctis-viola.theme.json"/>
    <themeProvider id="com.noctis.intellij.minimus" path="/themes/noctis-minimus.theme.json"/>
  </extensions>
</idea-plugin>
